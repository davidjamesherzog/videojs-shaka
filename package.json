{
  "name": "videojs-shaka",
  "version": "1.1.2",
  "description": "video.js shaka player tech",
  "main": "dist/videojs-shaka.cjs.js",
  "module": "dist/videojs-shaka.es.js",
  "browser": "dist/videojs-shaka.js",
  "generator-videojs-plugin": {
    "version": "9.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "build": "npm-run-all -s clean -p build:*",
    "build-prod": "cross-env-shell NO_TEST_BUNDLE=1 'npm run build'",
    "build-test": "cross-env-shell TEST_BUNDLE_ONLY=1 'npm run build'",
    "build:css": "postcss -o dist/videojs-shaka.css --config scripts/postcss.config.js src/plugin.css",
    "build:js": "rollup -c scripts/rollup.config.js",
    "clean": "shx rm -rf ./dist ./test/dist && shx mkdir -p ./dist ./test/dist",
    "docs": "npm-run-all docs:*",
    "docs:api": "jsdoc src -r -d docs/api",
    "docs:toc": "doctoc --notitle README.md",
    "lint": "vjsstandard",
    "prepublishOnly": "npm-run-all build-prod && vjsverify --verbose --skip-es-check",
    "sample": "npm run build && http-server -p 3000",
    "server": "karma start scripts/karma.conf.js --singleRun=false --auto-watch",
    "start": "npm-run-all -p server watch",
    "test": "npm-run-all lint build-test && karma start scripts/karma.conf.js",
    "posttest": "shx cat test/dist/coverage/text.txt",
    "update-changelog": "conventional-changelog -p videojs -i CHANGELOG.md -s",
    "preversion": "npm test",
    "version": "is-prerelease || npm run update-changelog && git add CHANGELOG.md",
    "watch": "npm-run-all -p watch:*",
    "watch:css": "npm run build:css -- -w",
    "watch:js": "npm run build:js -- -w"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "keywords": [
    "shaka-player",
    "videojs",
    "videojs-plugin"
  ],
  "author": "Dave Herzog <davidjherzog@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidjamesherzog/videojs-shaka"
  },
  "vjsstandard": {
    "ignore": [
      "dist",
      "docs",
      "test/dist"
    ]
  },
  "files": [
    "CONTRIBUTING.md",
    "dist/",
    "docs/",
    "index.html",
    "scripts/",
    "src/",
    "test/"
  ],
  "lint-staged": {
    "*.js": "vjsstandard --fix",
    "README.md": "doctoc --notitle"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "global": "^4.4.0",
    "video.js": "^8"
  },
  "peerDependencies": {
    "shaka-player": "^4.14.0 || ^5.0.0"
  },
  "devDependencies": {
    "@videojs/generator-helpers": "~3.2.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.5",
    "karma": "^6.4.4",
    "postcss": "^8.5.6",
    "postcss-cli": "^8.3.1",
    "rollup": "^2.79.2",
    "shaka-player": "^5.2.12",
    "sinon": "^21.0.0",
    "videojs-generate-karma-config": "~8.1.0",
    "videojs-generate-postcss-config": "~3.0.1",
    "videojs-generate-rollup-config": "~7.0.2",
    "videojs-generator-verify": "~4.1.3",
    "videojs-standard": "^9.1.0"
  }
}
